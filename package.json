{
  "name": "loopledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node scripts/migrate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:performance": "node scripts/seed.mjs --performance"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
