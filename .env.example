# mock is an in-browser development adapter. No database or credentials needed.
# Switch to http only AFTER Devadathan implements the /api/v1 endpoints.
NEXT_PUBLIC_DATA_MODE=mock
DATABASE_URL=postgresql://loopledger:loopledger@localhost:5432/loopledger
APP_URL=http://localhost:3000
# Set a random secret for real sessions; never commit a real value.
SESSION_SECRET=
# Server-only, opt-in simulation controls. Never expose in a production workspace.
ENABLE_DEMO_CLOCK=false
CRON_SECRET=
# Devadathan chooses/configures the SMTP provider during backend implementation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Local demo/test DB only. Supply a private fictitious demo password yourself.
ENABLE_DEMO_SEED=false
DEMO_PASSWORD=
# Disposable PostgreSQL used by connected tests (isolated temporary schemas).
DB_TEST_URL=
# 32-byte hex key, configured privately to encrypt reset email outbox payloads.
OUTBOX_ENCRYPTION_KEY=
# SMTP sends remain disabled until an approved provider is configured.
EMAIL_DELIVERY_ENABLED=false
# Must equal the isolated demo/test database name before enabling demo clock.
DEMO_DATABASE_NAME=
